{
  "name": "pdf-xiaojiang",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Privacy-first, offline PDF tools for Chromium browsers.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test": "node --test tests/*.test.ts",
    "check": "tsc --noEmit && npm test",
    "build": "node scripts/clean.mjs && npm run check && vite build && node scripts/copy-pdf-assets.mjs && node scripts/validate-build.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "e2e": "npm run build && node scripts/e2e.mjs"
  },
  "dependencies": {
    "docx-preview": "^0.3.6",
    "fflate": "^0.8.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
